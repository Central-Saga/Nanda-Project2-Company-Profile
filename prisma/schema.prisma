model JobOpening {
  id             String           @id @default(uuid()) @db.Uuid
  slug           String           @unique @db.VarChar(150)
  department     String?          @db.VarChar(100)
  employmentType EmploymentType   @default(full_time) @map("employment_type")
  workMode       WorkMode         @default(onsite) @map("work_mode")
  location       String?          @db.VarChar(150)
  salaryMin      Decimal?         @map("salary_min") @db.Decimal(14, 2)
  salaryMax      Decimal?         @map("salary_max") @db.Decimal(14, 2)
  salaryCurrency String?          @default("IDR") @map("salary_currency") @db.VarChar(10)
  showSalary     Boolean          @default(false) @map("show_salary")
  status         JobOpeningStatus @default(draft)
  openedAt       DateTime?        @map("opened_at") @db.Timestamptz
  closesAt       DateTime?        @map("closes_at") @db.Timestamptz
  createdBy      String           @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  author       User             @relation("JobOpeningAuthor", fields: [createdBy], references: [id], onDelete: Restrict)
  translations JobTranslation[]
  applications JobApplication[]

  @@map("job_openings")
}

model JobTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  jobId            String  @map("job_id") @db.Uuid
  locale           String  @db.VarChar(5)
  title            String  @db.VarChar(200)
  description      String? @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text
  benefits         String? @db.Text

  job JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, locale])
  @@map("job_translations")
}

model JobApplication {
  id             String            @id @default(uuid()) @db.Uuid
  jobId          String?           @map("job_id") @db.Uuid
  fullName       String            @map("full_name") @db.VarChar(150)
  email          String            @db.VarChar(190)
  phone          String?           @db.VarChar(30)
  cvMediaId      String?           @map("cv_media_id") @db.Uuid
  portfolioUrl   String?           @map("portfolio_url") @db.VarChar(255)
  githubUrl      String?           @map("github_url") @db.VarChar(255)
  linkedinUrl    String?           @map("linkedin_url") @db.VarChar(255)
  coverLetter    String?           @map("cover_letter") @db.Text
  expectedSalary Decimal?          @map("expected_salary") @db.Decimal(14, 2)
  availableFrom  DateTime?         @map("available_from") @db.Date
  status         ApplicationStatus @default(new)
  rating         Int?              @db.SmallInt
  consentPrivacy Boolean           @map("consent_privacy")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  job     JobOpening?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cvMedia MediaFile?                 @relation("AppCvMedia", fields: [cvMediaId], references: [id], onDelete: SetNull)
  history ApplicationStatusHistory[]

  @@index([jobId, status])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  fromStatus    String?  @map("from_status") @db.VarChar(50)
  toStatus      String   @map("to_status") @db.VarChar(50)
  note          String?  @db.Text
  changedBy     String   @map("changed_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user        User           @relation("AppStatusChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@map("application_status_history")
}

