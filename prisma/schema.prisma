model MediaFile {
  id             String    @id @default(uuid()) @db.Uuid
  uploadedBy     String?   @map("uploaded_by") @db.Uuid
  storageKey     String    @map("storage_key") @db.VarChar(500)
  url            String    @db.VarChar(500)
  originalName   String    @map("original_name") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  sizeBytes      Int       @map("size_bytes")
  width          Int?
  height         Int?
  altText        String?   @map("alt_text") @db.VarChar(255)
  folder         String?   @db.VarChar(100)
  isPublic       Boolean   @default(true) @map("is_public")
  isGallery      Boolean   @default(false) @map("is_gallery")
  checksumSha256 String?   @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  uploader User? @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  userAvatars         User[]                @relation("UserAvatar")
  companyProfiles     CompanyProfile[]      @relation("CompanyProfileLogo")
  serviceCovers       Service[]             @relation("ServiceCover")
  techLogos           Technology[]          @relation("TechLogo")
  clientLogos         Client[]              @relation("ClientLogo")
  projectCovers       Project[]             @relation("ProjectCover")
  projectMediaList    ProjectMedia[]
  testimonialPhotos   Testimonial[]         @relation("TestimonialAuthorPhoto")
  testimonialConsents Testimonial[]         @relation("TestimonialConsentDoc")
  teamMemberPhotos    TeamMember[]          @relation("TeamMemberPhoto")
  awardLogos          Award[]               @relation("AwardLogo")
  postCovers          Post[]                @relation("PostCover")
  briefAttachments    BriefAttachment[]
  jobApplicationsCv   JobApplication[]      @relation("AppCvMedia")
  galleryItems        GalleryItem[]
  seoOgImages         SeoMetadata[]         @relation("SeoOgImage")

  @@index([folder])
  @@index([checksumSha256])
  @@map("media_files")
}

model GalleryItem {
  id          String   @id @default(uuid()) @db.Uuid
  mediaId     String   @map("media_id") @db.Uuid
  title       String?  @db.VarChar(150)
  altText     String   @map("alt_text") @db.VarChar(255)
  caption     String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  media   MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  creator User?     @relation("GalleryItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("gallery_items")
}

model SiteSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     Json
  group     String?  @db.VarChar(50)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  updater User? @relation("SiteSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model SeoMetadata {
  id              String  @id @default(uuid()) @db.Uuid
  entityType      String  @map("entity_type") @db.VarChar(50)
  entityId        String  @map("entity_id") @db.VarChar(100)
  locale          String  @db.VarChar(5)
  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.Text
  ogImageMediaId  String? @map("og_image_media_id") @db.Uuid
  canonicalUrl    String? @map("canonical_url") @db.VarChar(500)
  robots          String? @default("index,follow") @db.VarChar(50)
  schemaJson      Json?   @map("schema_json")

  ogImage MediaFile? @relation("SeoOgImage", fields: [ogImageMediaId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, locale])
  @@map("seo_metadata")
}

model Redirect {
  id         String   @id @default(uuid()) @db.Uuid
  fromPath   String   @unique @map("from_path") @db.VarChar(500)
  toPath     String   @map("to_path") @db.VarChar(500)
  statusCode Int      @default(301) @map("status_code")
  hitCount   Int      @default(0) @map("hit_count")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("redirects")
}

model MenuItem {
  id           String       @id @default(uuid()) @db.Uuid
  menuLocation MenuLocation @map("menu_location")
  parentId     String?      @map("parent_id") @db.Uuid
  url          String       @db.VarChar(500)
  targetExists Boolean      @default(true) @map("target_exists")
  sortOrder    Int          @default(0) @map("sort_order")
  isActive     Boolean      @default(true) @map("is_active")
  openInNewTab Boolean      @default(false) @map("open_in_new_tab")

  parent       MenuItem?             @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]            @relation("MenuItemChildren")
  translations MenuItemTranslation[]

  @@map("menu_items")
}

model MenuItemTranslation {
  id         String @id @default(uuid()) @db.Uuid
  menuItemId String @map("menu_item_id") @db.Uuid
  locale     String @db.VarChar(5)
  label      String @db.VarChar(100)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
  @@map("menu_item_translations")
}

model CookieConsent {
  id            String   @id @default(uuid()) @db.Uuid
  visitorId     String   @map("visitor_id") @db.VarChar(100)
  necessary     Boolean  @default(true)
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  ipHash        String?  @map("ip_hash") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.Text
  policyVersion String?  @map("policy_version") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("cookie_consents")
}

